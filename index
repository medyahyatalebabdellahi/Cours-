        function calculateScore(data, prefix) {
            let totalScore = 0, maxScore = 0, correctCount = 0, wrongCount = 0, unansweredCount = 0;

            data.forEach(q => {
                const selected = [];
                q.options.forEach((_, optIndex) => {
                    const input = document.querySelector(`input[name="${prefix}-${q.id}"][value="${optIndex}"]`);
                    if (input && input.checked) selected.push(optIndex);
                });

                const block = document.getElementById(`${prefix}-${q.id}`);
                let isFullyCorrect = true, hasWrong = false;

                if (q.correct.length === 1) {
                    maxScore += 3;
                    if (selected.length === 0) { unansweredCount++; isFullyCorrect = false; }
                    else if (selected.length === 1 && selected[0] === q.correct[0]) { totalScore += 3; correctCount++; }
                    else { totalScore -= 0.25; wrongCount++; isFullyCorrect = false; hasWrong = true; }
                } else if (q.correct.length === 2) {
                    maxScore += 0.5;
                    let correctSelected = 0, wrongSelected = 0;
                    selected.forEach(s => { if (q.correct.includes(s)) correctSelected++; else wrongSelected++; });
                    if (selected.length === 0) { unansweredCount++; isFullyCorrect = false; }
                    else {
                        totalScore += correctSelected * 0.25;
                        if (wrongSelected > 0) { totalScore -= wrongSelected * 0.25; hasWrong = true; isFullyCorrect = false; }
                        if (correctSelected === q.correct.length && wrongSelected === 0) correctCount++;
                        else wrongCount++;
                    }
                } else if (q.correct.length === 3) {
                    maxScore += 0.375;
                    let correctSelected = 0, wrongSelected = 0;
                    selected.forEach(s => { if (q.correct.includes(s)) correctSelected++; else wrongSelected++; });
                    if (selected.length === 0) { unansweredCount++; isFullyCorrect = false; }
                    else {
                        totalScore += correctSelected * 0.125;
                        if (wrongSelected > 0) { totalScore -= wrongSelected * 0.25; hasWrong = true; isFullyCorrect = false; }
                        if (correctSelected === q.correct.length && wrongSelected === 0) correctCount++;
                        else wrongCount++;
                    }
                }

                if (isFullyCorrect && selected.length > 0) { block.classList.add('correct'); block.classList.remove('incorrect'); }
                else if (hasWrong || (selected.length > 0 && !isFullyCorrect)) { block.classList.add('incorrect'); block.classList.remove('correct'); }
                else { block.classList.remove('correct', 'incorrect'); }

                q.options.forEach((_, optIndex) => {
                    const label = document.getElementById(`${prefix}-${q.id}-opt-${optIndex}`);
                    const input = label.querySelector('input');
                    input.disabled = true;
                    if (q.correct.includes(optIndex)) label.classList.add('correct-answer');
                    if (selected.includes(optIndex) && !q.correct.includes(optIndex)) label.classList.add('wrong-answer');
                });
            });

            if (totalScore < 0) totalScore = 0;
            totalScore = Math.round(totalScore * 100) / 100;
            const finalScore = maxScore > 0 ? (totalScore / maxScore) * 15 : 0;
            return { rawScore: totalScore, maxScore, finalScore: Math.round(finalScore * 100) / 100, correctCount, wrongCount, unansweredCount };
        }

