<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منصة المراجعة القانونية - أعداد: يحيى طالب عبد الله</title>
    <style>
        :root {
            --red-dark: #b71c1c;
            --red-old: #7f1d1d;
            --orange: #d4a017;
            --yellow-dark: #d4af37;
            --green-dark: #0b3d2e;
            --green: #2e7d32;
            --white: #ffffff;
            --text-dark: #212121;
            --text-light: #555555;
            --border-radius: 12px;
            --font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: var(--font-family);
            background: linear-gradient(135deg, #f7fbf8 0%, #eaf4ed 35%, #dcefe2 70%, #c8dfcf 100%);
            background-attachment: fixed;
            color: var(--text-dark);
            line-height: 1.7;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 20px;
        }

        .app-container {
            max-width: 1100px;
            width: 100%;
            background-color: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(10px);
            border-radius: 18px;
            box-shadow: 0 15px 50px rgba(11, 61, 46, 0.22);
            overflow: hidden;
            border: 4px solid var(--green-dark);
        }

        /* ==================== الهيدر ==================== */
        header {
            background: linear-gradient(135deg, var(--green-dark), var(--green));
            color: var(--white);
            padding: 28px 30px;
            text-align: center;
            border-bottom: 5px solid var(--yellow-dark);
            position: relative;
        }

        header h1 {
            font-size: 2rem;
            margin-bottom: 10px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-shadow: 3px 3px 6px rgba(0,0,0,0.4);
        }

        header .author {
            font-size: 1.3rem;
            margin-top: 10px;
            font-weight: 700;
            color: #f5d76e;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
        }

        header .contact-info {
            font-size: 1.15rem;
            background: rgba(0,0,0,0.16);
            display: inline-block;
            padding: 8px 25px;
            border-radius: 50px;
            margin-top: 12px;
            direction: ltr;
            border: 2px solid var(--yellow-dark);
        }

        header .contact-info span {
            direction: rtl;
            unicode-bidi: embed;
        }

        header .wish {
            font-size: 1.05rem;
            margin-top: 8px;
            font-style: italic;
            color: #a5d6a7;
        }

        /* ==================== التنقل ==================== */
        .nav-tabs {
            display: flex;
            background: linear-gradient(180deg, #ffffff, #f1f7f3);
            border-bottom: 3px solid var(--green-dark);
            flex-wrap: wrap;
        }

        .nav-tabs button {
            flex: 1;
            padding: 16px 8px;
            border: none;
            background: transparent;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            color: var(--green-dark);
            border-bottom: 5px solid transparent;
            font-family: var(--font-family);
            min-width: 140px;
        }

        .nav-tabs button:hover {
            background: rgba(46, 125, 50, 0.08);
            color: var(--green-dark);
        }

        .nav-tabs button.active {
            background: var(--white);
            color: var(--green-dark);
            border-bottom: 5px solid var(--green-dark);
            box-shadow: inset 0 -3px 0 var(--yellow-dark);
        }

        /* ==================== المحتوى ==================== */
        .content-area { padding: 30px; min-height: 500px; }

        .section { display: none; animation: fadeIn 0.5s ease; }
        .section.active { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ==================== الملخصات ==================== */
        .summary-card {
            background: var(--white);
            border-radius: var(--border-radius);
            padding: 22px;
            margin-bottom: 22px;
            box-shadow: 0 5px 20px rgba(11, 61, 46, 0.10);
            border-right: 6px solid var(--green);
            border-left: 3px solid var(--yellow-dark);
            border-top: 2px solid var(--yellow-dark);
            text-align: right;
            transition: transform 0.2s;
        }

        .summary-card:hover { transform: translateX(-5px); }

        .summary-card h3 {
            color: var(--green-dark);
            margin-bottom: 12px;
            font-size: 1.35rem;
            border-bottom: 3px solid var(--yellow-dark);
            padding-bottom: 10px;
        }

        .summary-card p { color: var(--text-dark); font-size: 1rem; margin-bottom: 8px; }
        .summary-card ul { padding-right: 20px; margin-top: 5px; }
        .summary-card ul li { margin-bottom: 6px; }
        .summary-card ul li::marker { color: #b08a00; }

        /* ==================== الاختبارات ==================== */
        .quiz-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 3px solid var(--green);
            flex-wrap: wrap;
            gap: 10px;
        }

        .quiz-header h2 { color: var(--green-dark); font-size: 1.5rem; }

        .score-display {
            font-size: 1.2rem;
            font-weight: bold;
            background: linear-gradient(135deg, var(--green-dark), var(--green));
            color: var(--white);
            padding: 10px 22px;
            border-radius: 50px;
            border: 3px solid var(--yellow-dark);
            box-shadow: 0 4px 12px rgba(11,61,46,0.25);
        }

        .question-block {
            background: var(--white);
            border-radius: var(--border-radius);
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
            border: 1px solid #e0e0e0;
            transition: border-color 0.3s ease, box-shadow 0.3s;
            border-right: 5px solid var(--green);
        }

        .question-block:hover { box-shadow: 0 5px 25px rgba(11,61,46,0.14); }

        .question-block.correct {
            border: 2px solid var(--green);
            background: #e8f5e9;
            border-right: 8px solid var(--green-dark);
        }

        .question-block.incorrect {
            border: 2px solid var(--red-dark);
            background: #ffebee;
            border-right: 8px solid var(--red-dark);
        }

        .question-block h3 {
            font-size: 1.1rem;
            margin-bottom: 15px;
            color: var(--text-dark);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
        }

        .question-number {
            background: linear-gradient(135deg, var(--red-dark), var(--orange));
            color: var(--white);
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            white-space: nowrap;
            border: 2px solid var(--yellow-dark);
        }

        .options-container { display: flex; flex-direction: column; gap: 10px; }

        .option-label {
            display: flex;
            align-items: center;
            padding: 13px 16px;
            background: #fbfdfb;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.2s ease, border 0.2s ease, transform 0.1s;
            border: 2px solid transparent;
            font-size: 1rem;
        }

        .option-label:hover {
            background: #fffbea;
            border-color: #f5d76e;
            transform: scale(1.01);
        }

        .option-label input[type="checkbox"], 
        .option-label input[type="radio"] {
            margin-left: 12px;
            width: 20px;
            height: 20px;
            accent-color: var(--green-dark);
            cursor: pointer;
        }

        .option-label.selected { background: #fffbea; border-color: #b08a00; }
        .option-label.correct-answer { background: #e2f2e6; border-color: var(--green-dark); font-weight: 600; }
        .option-label.wrong-answer { background: #fde8e8; border-color: var(--green-dark); text-decoration: line-through; }

        .submit-btn {
            background: linear-gradient(135deg, var(--green-dark), var(--green));
            color: var(--white);
            border: 3px solid var(--yellow-dark);
            padding: 16px 45px;
            font-size: 1.2rem;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 700;
            transition: transform 0.2s, box-shadow 0.2s;
            display: block;
            margin: 30px auto 10px;
            box-shadow: 0 6px 20px rgba(11, 61, 46, 0.25);
            font-family: var(--font-family);
        }

        .submit-btn:hover { transform: scale(1.04); box-shadow: 0 8px 30px rgba(11, 61, 46, 0.35); }
        .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

        .result-box {
            text-align: center;
            padding: 35px;
            background: var(--white);
            border-radius: var(--border-radius);
            box-shadow: 0 10px 40px rgba(11,61,46,0.18);
            margin-top: 20px;
            border: 4px solid var(--green-dark);
            display: none;
        }

        .result-box.show { display: block; animation: fadeIn 0.5s ease; }
        .result-box h2 { font-size: 2rem; color: var(--green-dark); }
        .result-box .final-score {
            font-size: 3.8rem;
            font-weight: 900;
            color: var(--green-dark);
            margin: 15px 0;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }
        .result-box .score-detail { font-size: 1.1rem; color: var(--text-light); }

        /* ==================== الصفحة الاحترافية ==================== */
        .pro-page {
            text-align: center;
            padding: 45px 25px;
            border: 6px solid var(--red-dark);
            border-radius: var(--border-radius);
            background: linear-gradient(135deg, #ffffff, #f7fbf8, #edf6f0);
            box-shadow: inset 0 0 40px rgba(11,61,46,0.06), 0 10px 40px rgba(11,61,46,0.18);
            position: relative;
        }

        .pro-page::before {
            content: "⚖️";
            position: absolute;
            top: -25px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 3rem;
            background: var(--white);
            padding: 0 20px;
            border-radius: 50%;
        }

        .pro-page h2 {
            font-size: 3rem;
            color: var(--green-dark);
            margin-bottom: 30px;
            text-shadow: 3px 3px 0 var(--yellow-dark);
            margin-top: 20px;
        }

        .pro-page .card {
            background: var(--white);
            border-radius: var(--border-radius);
            padding: 40px;
            box-shadow: 0 10px 40px rgba(11,61,46,0.18);
            max-width: 700px;
            margin: 0 auto;
            border: 3px solid var(--green);
            border-top: 8px solid var(--yellow-dark);
            position: relative;
        }

        .pro-page .card p { font-size: 1.2rem; margin-bottom: 15px; color: var(--text-dark); }

        .pro-page .card .big-number {
            font-size: 5rem;
            font-weight: 900;
            color: var(--green-dark);
            text-shadow: 4px 4px 0 var(--yellow-dark);
            line-height: 1.2;
        }

        .pro-page .card hr { border: 3px dashed var(--orange); margin: 25px 0; }

        .pro-page .card .contact-line {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--green-dark);
            direction: ltr;
            background: #e8f5e9;
            padding: 10px;
            border-radius: 50px;
            border: 2px solid var(--green);
        }

        .pro-page .card .contact-line span {
            direction: rtl;
            unicode-bidi: embed;
        }

        .pro-page .card .author-line {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--green-dark);
            margin-top: 10px;
        }

        .pro-page .card .badge {
            display: inline-block;
            background: linear-gradient(135deg, var(--red-dark), var(--orange));
            color: var(--white);
            padding: 8px 25px;
            border-radius: 50px;
            font-size: 1rem;
            margin-top: 15px;
            border: 2px solid var(--yellow-dark);
        }

        /* ==================== تجاوب ==================== */
        @media (max-width: 768px) {
            header h1 { font-size: 1.3rem; }
            .nav-tabs button { font-size: 0.8rem; padding: 12px 5px; min-width: 110px; }
            .content-area { padding: 15px; }
            .question-block h3 { font-size: 1rem; flex-direction: column; align-items: flex-start; }
            .option-label { font-size: 0.9rem; }
            .result-box .final-score { font-size: 2.5rem; }
            .pro-page h2 { font-size: 2rem; }
            .pro-page .card .big-number { font-size: 3.5rem; }
        }
    </style>
</head>
<body>

    <div class="app-container">
        <!-- الهيدر -->
        <header>
            <h1>⚖️ منصة المراجعة القانونية الشاملة ⚖️</h1>
            <div class="author">أعداد: يحيى طالب عبد الله</div>
            <div class="contact-info"><span>رقم اتصال وواتساب:</span> 30545727</div>
            <div class="wish">توفيق للجميع</div>
        </header>

        <!-- أزرار التنقل -->
        <div class="nav-tabs">
            <button id="btnSummary" class="active" onclick="switchTab('summary')">📚 ملخص PDF</button>
            <button id="btnQuiz1" onclick="switchTab('quiz1')">📝 اختبار 1 (60 سؤال)</button>
            <button id="btnQuiz2" onclick="switchTab('quiz2')">🔥 اختبار 2 (20 سؤال صعب)</button>
            <button id="btnQuiz3" onclick="switchTab('quiz4')">💎 صفحة احترافية</button>
        </div>

        <!-- المحتوى -->
        <div class="content-area">

            <!-- قسم الملخصات -->
            <div id="summary" class="section active">
                <div class="summary-card">
                    <h3>📌 ملخص النظام الأساسي لموظفي كتابات الضبط والنيابات (مرسوم 171/2009)</h3>
                    <p><strong>التصنيف:</strong> ينقسم الموظفون إلى ثلاثة أسلاك: كتاب الضبط الرئيسيين (الفئة أ)، كتاب الضبط (الفئة ب)، وكتاب العدل والنيابات (الفئة ج).</p>
                    <p><strong>الترقية:</strong> تتم كل سنتين بالأقدمية داخل الدرجة. الترقية بين الدرجات تتم بالاختيار أو الامتحان المهني. الدرجة الخاصة تتطلب 4 سنوات أقدمية على الأقل في الدرجة الأولى.</p>
                    <p><strong>شروط الولوج:</strong> كتاب الضبط الرئيسيين: شهادة عليا في القانون/التشريع. كتاب الضبط: شهادة إعدادية. كتاب العدل: شهادة ابتدائية. مع تكوين متخصص في جميع الحالات.</p>
                    <p><strong>اليمين:</strong> يؤدي الموظفون اليمين أمام المحكمة قبل مباشرة مهامهم.</p>
                </div>
                <div class="summary-card">
                    <h3>📌 ملخص التنظيم القضائي الموريتاني</h3>
                    <p><strong>المحاكم:</strong> المحكمة العليا، محاكم الاستئناف، محاكم الولايات، المحاكم الجنائية، التجارية، محاكم الشغل، ومحاكم المقاطعات.</p>
                    <p><strong>المبادئ:</strong> استقلال القضاء، المساواة أمام القضاء، مجانية التقاضي، علنية الجلسات، التقاضي على درجتين.</p>
                    <p><strong>النيابة العامة:</strong> تمارس الدعوى العمومية، وتخضع للسلطة الرئاسية، وتتميز بوحدة النيابة واستقلال قضاة النيابة عن قضاة الحكم.</p>
                    <p><strong>المسطرة الجنائية:</strong> تفترض البراءة، لا يعتد بالاعتراف المنتزع بالإكراه، الشك يفسر لصالح المتهم. السلطات المكلفة: الشرطة القضائية والنيابة العامة.</p>
                </div>
                <div class="summary-card">
                    <h3>📌 ملخص المسطرة المدنية والطعون</h3>
                    <p><strong>شروط الدعوى:</strong> الأهلية، الصفة، المصلحة. الطلبات: أصلية وعارضة (إضافية، مقابلة، تدخل، إدخال).</p>
                    <p><strong>الدفوع:</strong> شكلية (إجرائية)، موضوعية (جوهر النزاع)، ودفع بعدم القبول.</p>
                    <p><strong>الطعون العادية:</strong> المعارضة (في الأحكام الغيابية)، الاستئناف (في الأحكام الابتدائية).</p>
                    <p><strong>الطعون غير العادية:</strong> اعتراض الغير، طلب المراجعة، الطعن بالنقض، الطعن لصالح القانون.</p>
                </div>
                <div class="summary-card">
                    <h3>📌 ملخص القضاء الواقف والنيابة العامة</h3>
                    <p><strong>القضاء الواقف:</strong> يشمل قضاة النيابة العامة والشرطة القضائية. النيابة العامة تمارس الدعوى العمومية وتطلب تطبيق القانون.</p>
                    <p><strong>مميزات النيابة:</strong> جهاز قضائي خاص، خاضع للسلطة الرئاسية، وحدوي، مستقل عن قضاة الحكم والتحقيق، لا يمكن رد قضاته، غير مسؤول، وغير مرتبط بمطالبه (قلم أسير ولسان حر).</p>
                    <p><strong>الشرطة القضائية:</strong> تتولى البحث والتحقيق الأولي، وتتلقى الشكاوى، وتنفذ أوامر التحقيق.</p>
                    <p><strong>حالات التلبس:</strong> ضبط الفاعل متلبساً، مطاردة الجمهور، وجود آثار أو أدلة قريبة من ارتكاب الفعل.</p>
                </div>
            </div>

            <!-- اختبار 1 -->
            <div id="quiz1" class="section">
                <div class="quiz-header">
                    <h2>📝 الاختبار الأول: 60 سؤالاً مختلفاً 100%</h2>
                    <div class="score-display">النقاط: <span id="score1">0</span> / 15</div>
                </div>
                <div id="quiz1-container"></div>
                <button class="submit-btn" id="submit1" onclick="submitQuiz1()">عرض النتيجة النهائية</button>
                <div id="result1" class="result-box"></div>
            </div>

            <!-- اختبار 2 -->
            <div id="quiz2" class="section">
                <div class="quiz-header">
                    <h2>🔥 الاختبار الثاني: 20 سؤالاً صعباً جداً 100%</h2>
                    <div class="score-display">النقاط: <span id="score2">0</span> / 15</div>
                </div>
                <div id="quiz2-container"></div>
                <button class="submit-btn" id="submit2" onclick="submitQuiz2()">عرض النتيجة النهائية</button>
                <div id="result2" class="result-box"></div>
            </div>

            <!-- اختبار 3 -->
            <div id="quiz3" class="section">
                <div class="quiz-header">
                    <h2>⚖️ الاختبار الثالث: ثقافة عامة للقضاة والجريمة والعدل (متوسط وصعب)</h2>
                    <div class="score-display">النقاط: <span id="score3">0</span> / 15</div>
                </div>
                <div id="quiz3-container"></div>
                <button class="submit-btn" id="submit3" onclick="submitQuiz3()">عرض النتيجة النهائية</button>
                <div id="result3" class="result-box"></div>
            </div>

            <!-- الصفحة الاحترافية -->
            <div id="quiz4" class="section">
                <div class="pro-page">
                    <h2>💎 الصفحة الاحترافية</h2>
                    <div class="card">
                        <p>منصة المراجعة القانونية الشاملة</p>
                        <p>للمساطر المدنية والجنائية والتنظيم القضائي الموريتاني</p>
                        <hr>
                        <p class="big-number">100</p>
                        <p>سؤال متنوع في القانون القضائي والمساطر</p>
                        <p style="font-size:1rem; color:#555;">اختبار 1: 60 سؤال | اختبار 2: 20 سؤال | اختبار 3: ثقافة عامة</p>
                        <hr>
                        <p class="author-line">أعداد: يحيى طالب عبد الله</p>
                        <p class="contact-line"><span>رقم اتصال وواتساب:</span> 30545727</p>
                        <p style="color: var(--green-dark); font-weight: bold; margin-top: 15px; font-size:1.3rem;">توفيق للجميع</p>
                        <div class="badge">⚖️ النظام القضائي الموريتاني ⚖️</div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        // ==================== البيانات ====================
        
        // الاختبار الأول: 60 سؤالاً مختلفاً 100%
        const quiz1Data = [
            { id: 1, type: 1, q: "ما هو المرسوم الذي يتضمن النظام الأساسي الخاص بموظفي كتابات الضبط والنيابات؟", options: ["مرسوم 171/2009", "مرسوم 93-09", "مرسوم 74/01", "مرسوم 386/69"], correct: [0] },
