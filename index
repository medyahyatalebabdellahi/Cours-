            document.getElementById('submit2').disabled = false;
            document.querySelectorAll('#quiz2-container .question-block').forEach(b => b.classList.remove('correct', 'incorrect'));
            document.querySelectorAll('#quiz2-container input').forEach(i => { i.checked = false; i.disabled = false; });
            document.querySelectorAll('#quiz2-container .option-label').forEach(l => l.classList.remove('selected', 'correct-answer', 'wrong-answer'));
        }

        function submitQuiz2() {
            const result = calculateScore(quiz2Data, 'q2');
            document.getElementById('score2').textContent = result.finalScore;
            document.getElementById('submit2').disabled = true;
            document.getElementById('result2').innerHTML = `
                <h2>النتيجة النهائية</h2>
                <div class="final-score">${result.finalScore} / 15</div>
                <div class="score-detail">
                    <p>مجموع النقاط الخام: ${result.rawScore} من ${result.maxScore}</p>
                    <p>الإجابات الصحيحة: ${result.correctCount} | الإجابات الخاطئة: ${result.wrongCount} | بدون إجابة: ${result.unansweredCount}</p>
                    <p style="margin-top:10px; font-weight:bold; color: var(--green-dark);">تم احتساب النتيجة على 15</p>
                </div>`;
            document.getElementById('result2').classList.add('show');
        }

        // ==================== دوال الاختبار الثالث ====================
        let quiz3Rendered = false;

        function renderQuiz3() {
            if (quiz3Rendered) return;
            const container = document.getElementById('quiz3-container');
            let html = '';
            quiz3Data.forEach((q, index) => {
                const inputType = q.correct.length === 1 ? 'radio' : 'checkbox';
                html += `<div class="question-block" id="q3-${q.id}">
                    <h3><span>${q.q}</span><span class="question-number">سؤال ${index + 1}</span></h3>
                    <div class="options-container">`;
                q.options.forEach((opt, optIndex) => {
                    html += `<label class="option-label" id="q3-${q.id}-opt-${optIndex}">
                        <input type="${inputType}" name="q3-${q.id}" value="${optIndex}">${opt}
                    </label>`;
                });
                html += `</div></div>`;
            });
            container.innerHTML = html;
            quiz3Rendered = true;

            container.querySelectorAll('input').forEach(input => {
                input.addEventListener('change', function() {
                    const parentLabel = this.closest('.option-label');
                    if (this.type === 'radio') {
                        document.querySelectorAll(`input[name="${this.name}"]`).forEach(r => r.closest('.option-label').classList.remove('selected'));
                    }
                    if (this.checked) parentLabel.classList.add('selected');
                    else parentLabel.classList.remove('selected');
                });
            });
        }

        function resetQuiz3() {
            renderQuiz3();
            document.getElementById('score3').textContent = '0';
            document.getElementById('result3').classList.remove('show');
            document.getElementById('result3').innerHTML = '';
            document.getElementById('submit3').disabled = false;
            document.querySelectorAll('#quiz3-container .question-block').forEach(b => b.classList.remove('correct', 'incorrect'));
            document.querySelectorAll('#quiz3-container input').forEach(i => { i.checked = false; i.disabled = false; });
            document.querySelectorAll('#quiz3-container .option-label').forEach(l => l.classList.remove('selected', 'correct-answer', 'wrong-answer'));
        }

        function submitQuiz3() {
            const result = calculateScore(quiz3Data, 'q3');
            document.getElementById('score3').textContent = result.finalScore;
            document.getElementById('submit3').disabled = true;
            document.getElementById('result3').innerHTML = `
                <h2>النتيجة النهائية</h2>
                <div class="final-score">${result.finalScore} / 15</div>
                <div class="score-detail">
                    <p>مجموع النقاط الخام: ${result.rawScore} من ${result.maxScore}</p>
                    <p>الإجابات الصحيحة: ${result.correctCount} | الإجابات الخاطئة: ${result.wrongCount} | بدون إجابة: ${result.unansweredCount}</p>
                    <p style="margin-top:10px; font-weight:bold; color: var(--green-dark);">تم احتساب النتيجة على 15</p>
                </div>`;
            document.getElementById('result3').classList.add('show');
        }

        // ==================== التهيئة ====================
        document.addEventListener('DOMContentLoaded', () => {
            renderQuiz1();
            renderQuiz2();
            renderQuiz3();
        });

        window.switchTab = switchTab;
        window.submitQuiz1 = submitQuiz1;
        window.submitQuiz2 = submitQuiz2;
        window.submitQuiz3 = submitQuiz3;
    </script>
</body>
</html>
